# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.production
*.env
# Next loads `.env.development.local` and `.env.production.local` too, and neither was covered by
# the lines above: a local override with a secret in it was one `git add .` away from being committed.
.env*.local

# Private keys (IMPORTANT!)
private-key.txt
*.key
*.pem

# Deployment
.vercel
.deployment

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
out/
.next/

# Local point store (file driver for the Points Program)
.data/

# Freebuff agent scratch: only the dev-server logs are ignored here.
# The run doc (/.freebuff/run.md) is deliberately NOT ignored — the file tooling used to
# maintain it respects ignore rules, so ignoring the whole directory made it uneditable.
.freebuff/*.log
.freebuff/*.log.err
.freebuff/*.pid
.freebuff/*.env
.freebuff/project-id
# The dev server's own output and the machine-specific state a tool writes back: both are
# rewritten on every run, so committing them would put a diff in every future release that
# says nothing about the code. Named individually rather than as `*` — see above.
.freebuff/dev.out
.freebuff/dev.err
.freebuff/discord-state.json

# Temporary files
*.tmp
*.temp
.cache/

# Smart contract artifacts (if using Hardhat)
artifacts/
cache/
typechain/
typechain-types/

# Foundry (the toolchain installs to ~/.foundry; these are local build dirs).
# `out/` is already ignored above, next to build/ and .next/.
broadcast/
.foundry/

# Coverage
coverage/
.nyc_output/

# Security reports (local only)
REPORT.MD
REPORT.pdf
