<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dungeon Knights - Adventure</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="themed-styles-centered.css?v=1789100900">
    <link rel="stylesheet" href="shared-wallet.css">
    <link rel="stylesheet" href="transaction-modal.css">
    <link rel="stylesheet" href="leaderboard.css">
    <link rel="stylesheet" href="medieval-theme.css">
    <link rel="stylesheet" href="medieval-components.css">
    <link rel="stylesheet" href="medieval-game.css">
    <link rel="stylesheet" href="medieval-effects.css">
</head>
<body data-dungeon-theme="crypts">
    <div class="game-container">
        <!-- CASTLE HEADER -->
        <header class="castle-header game-header">
            <button class="medieval-btn medieval-btn-stone" onclick="window.location.href='menu.html'" style="padding: 10px 20px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                <img src="assets/ui/sword.png" alt="Sword" style="width: 20px; height: 20px; filter: brightness(1.2);">
                Select Knights
            </button>
            <div class="castle-logo header-title">
                <div class="header-title-icon">
                    <img src="assets/ui/castle.png" alt="Castle" style="width: 32px; height: 32px;">
                </div>
                <div class="header-title-text">DUNGEON KNIGHTS</div>
            </div>
            <div class="treasure-pouch" id="walletWidgetGame">
                <span class="treasure-amount" id="headerDngBalance">0 DNG</span>
            </div>
        </header>

        <!-- MAIN GAME AREA WITH DECORATIVE BORDERS -->
        <main class="game-main">
            <!-- LEFT PANEL: ACTIVE SQUAD -->
            <aside class="squad-panel parchment-bg">
                <div class="panel-header medieval-subtitle">
                    <span class="panel-icon">
                        <img src="assets/ui/sword.png" alt="Sword" style="width: 24px; height: 24px;">
                    </span>
                    <span id="squadPanelTitle">Active Squad</span>
                </div>
                <div class="squad-list" id="squadList">
                    <!-- Dynamically populated knight cards -->
                </div>
            </aside>
            
            <!-- CENTER: GAME CANVAS WITH FRAME -->
            <div class="canvas-wrapper">
                <!-- VIDEO BACKGROUND -->
                <video id="dungeonBackground" autoplay loop muted playsinline class="dungeon-video-bg">
                    <source src="maps/map/animated/crypts-map-animated.mp4" type="video/mp4">
                </video>
                
                <!-- DECORATIVE CORNER PIECES (4) -->
                <div class="border-corner corner-tl" id="cornerTL"></div>
                <div class="border-corner corner-tr" id="cornerTR"></div>
                <div class="border-corner corner-bl" id="cornerBL"></div>
                <div class="border-corner corner-br" id="cornerBR"></div>
                
                <!-- DECORATIVE BORDER TILES (4 sides) -->
                <div class="border-tile border-top" id="borderTop"></div>
                <div class="border-tile border-bottom" id="borderBottom"></div>
                <div class="border-tile border-left vertical" id="borderLeft"></div>
                <div class="border-tile border-right vertical" id="borderRight"></div>
                
                <!-- GAME CANVAS (Center) -->
                <canvas id="gameCanvas" width="1140" height="600"></canvas>
                
                <!-- ATMOSPHERIC TEXT OVERLAY -->
                <div class="atmosphere-text" id="atmosphereText">DARK DEPTHS...</div>
            </div>
            
            <!-- RIGHT PANEL: INFO DISPLAY -->
            <aside class="info-panel parchment-bg">
                <!-- WALLET BALANCE -->
                <section class="info-section">
                    <div class="rune-stone">
                        <div class="rune-label" id="ownerMarkTitle">Wallet Balance</div>
                        <div class="rune-value" id="ownerMark">0 DNG</div>
                    </div>
                </section>
                
                <!-- TOTAL CLAIMED -->
                <section class="info-section">
                    <div class="rune-stone">
                        <div class="rune-label" id="resourcePoolTitle">Total Claimed</div>
                        <div class="rune-value" id="resourceAmount">0 DNG</div>
                    </div>
                </section>
                
                <!-- CHEST DISPLAY -->
                <section class="chest-display">
                    <div class="chest-image torch-glow" id="chestImage"></div>
                </section>
                
                <!-- UNCLAIMED REWARDS -->
                <section class="info-section">
                    <div class="rewards-panel scroll-card">
                        <div class="scroll-title medieval-subtitle">Unclaimed Rewards</div>
                        <div class="rewards-total" id="rewardsTotal">0.00 DNG</div>
                        <div class="rewards-meta">
                            <span id="rewardsCompletions">Completions: 0</span>
                        </div>
                        <button class="medieval-btn" id="claimAllBtn" style="width: 100%; margin: 8px 0; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <img src="assets/ui/right tick.png" alt="Claim" style="width: 16px; height: 16px;">
                            Claim All
                        </button>
                        <button class="medieval-btn medieval-btn-stone" id="viewHistoryBtn" style="width: 100%; margin: 8px 0;">
                            History
                        </button>
                        <button class="medieval-btn medieval-btn-stone" id="leaderboardBtn" style="width: 100%; margin: 8px 0;">
                            Leaderboard
                        </button>
                    </div>
                </section>
            </aside>
            
            <!-- PARCHMENT NOTIFICATION -->
            <div class="parchment-note scroll-card" id="parchmentNote">
                <div class="parchment-title medieval-subtitle">Welcome Adventurer!</div>
                <div class="parchment-text medieval-body">Press 'H' for shortcuts</div>
                <div class="parchment-text medieval-body">Deploy knights to begin!</div>
            </div>
        </main>

        <!-- BOTTOM CONTROL BAR -->
        <footer class="control-bar stone-bg">
            <!-- Left: Action Buttons -->
            <div class="control-buttons">
                <button class="medieval-btn medieval-btn-gold game-btn" id="deployBtn">
                    <span class="game-btn-icon">
                        <img src="assets/ui/sword.png" alt="Deploy" style="width: 20px; height: 20px;">
                    </span>
                    <span>DEPLOY</span>
                </button>
                <button class="medieval-btn medieval-btn-red game-btn" id="recallBtn">
                    <span class="game-btn-icon">
                        <img src="assets/ui/exit cross.png" alt="Recall" style="width: 20px; height: 20px;">
                    </span>
                    <span>RECALL</span>
                </button>
                <button class="medieval-btn medieval-btn-stone game-btn" id="menuBtn">
                    <span class="game-btn-icon">
                        <img src="assets/ui/castle.png" alt="Menu" style="width: 20px; height: 20px;">
                    </span>
                    <span>MENU</span>
                </button>
            </div>
            
            <!-- Center: Status Display -->
            <div class="status-display">
                <div class="status-item">
                    <span class="medieval-body">DNG/min: </span>
                    <strong id="dngRate" class="stat-highlight">0</strong>
                </div>
                <div class="status-item">
                    <span class="medieval-body">Active: </span>
                    <strong id="activeKnights" class="stat-highlight">0/15</strong>
                </div>
                <div class="status-item">
                    <span class="medieval-body">Loot: </span>
                    <strong id="activeLoot" class="stat-highlight">0</strong>
                </div>
                <div class="status-item">
                    <span class="medieval-body">Est. Time: </span>
                    <strong id="estimatedTime" class="stat-highlight">--</strong>
                </div>
            </div>
            
            <!-- Right: Stats Button -->
            <div class="control-buttons">
                <button class="medieval-btn medieval-btn-stone game-btn" id="statsBtn">
                    <span class="game-btn-icon">
                        <img src="assets/ui/sword.png" alt="Stats" style="width: 20px; height: 20px;">
                    </span>
                    <span>STATS</span>
                </button>
            </div>
        </footer>
    </div>

    <!-- DUNGEON COMPLETION MODAL -->
    <div id="completionModal" class="modal hidden">
        <div class="modal-content">
            <h2 style="margin-bottom: 20px;">Dungeon Cleared!</h2>
            <div class="completion-stats" style="margin-bottom: 30px;">
                <p><strong>Dungeon:</strong> <span id="completedDungeon">-</span></p>
                <p><strong>Gold Earned:</strong> <span id="completionGold">0</span> DNG</p>
                <p><strong>Time:</strong> <span id="completionTime">0:00</span></p>
            </div>
            <div class="modal-actions" style="display: flex; gap: 12px; justify-content: center;">
                <button class="rewards-btn claim-btn" id="nextDungeonBtn" style="min-width: 180px;">
                    Next Dungeon
                </button>
                <button class="rewards-btn history-btn" id="replayDungeonBtn" style="min-width: 180px;">
                    Replay Dungeon
                </button>
            </div>
        </div>
    </div>

    <!-- KEYBOARD SHORTCUTS OVERLAY -->
    <div id="shortcutsOverlay" class="modal hidden">
        <div class="modal-content">
            <h2 style="margin-bottom: 20px;">Keyboard Shortcuts</h2>
            <div style="text-align: left; margin-bottom: 30px;">
                <p><strong>Space</strong> - Deploy Knights</p>
                <p><strong>Esc</strong> - Recall Knights</p>
                <p><strong>H</strong> - Show/Hide Shortcuts</p>
            </div>
            <button class="rewards-btn claim-btn" id="shortcutsClose">Close</button>
        </div>
    </div>

    <!-- Scripts -->
    <!-- Shared Wallet System -->
    <script src="ethers-5.7.2.umd.min.js"></script>
    <script src="config.js?v=1789100900"></script>
    <script src="contract-addresses.js?v=3"></script>
    <script src="wallet.js?v=1789100900"></script>
    <script src="shared-header.js?v=1789100900"></script>
    
    <!-- Transaction Modal -->
    <script src="transaction-modal.js?v=2"></script>
    
    <!-- Leaderboard -->
    <script src="leaderboard.js?v=2"></script>
    
    <!-- Dungeon Session System -->
    <script src="dungeon-session.js?v=3"></script>
    <script src="reward-claim-ui.js?v=2"></script>
    
    <!-- Game Scripts -->
    <script src="audio.js?v=1789100900"></script>
    <script src="characters.js?v=1789100900"></script>
    <script src="dungeon.js?v=1789100900"></script>
    <script src="pathfinding.js?v=1789100900"></script>
    <script src="combat.js?v=1789100900"></script>
    <script src="ui.js?v=1789100900"></script>
    <script src="medieval-effects.js"></script>
    <script src="game.js?v=1789100900"></script>
</body>
</html>
