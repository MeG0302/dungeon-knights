{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/points/draw",
      "schedule": "10 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.dungeonknights.io" }],
      "destination": "https://dungeonknights.io/$1",
      "permanent": true
    }
  ]
}
